{
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "esbuild src/index.ts src/renderer/worker/curve_worker.ts src/ui/vector_field_worker.ts --bundle --outdir=dist --minify --sourcemap",
    "watch": "esbuild src/index.ts src/renderer/worker/curve_worker.ts src/ui/vector_field_worker.ts --bundle --outdir=dist --minify --sourcemap --watch",
    "serve": "http-server ./",
    "dev": "concurrently \"npm run watch\" \"npm run serve\""
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "cm6-theme-solarized-dark": "^0.2.0",
    "codemirror": "^6.0.2",
    "ionicons": "^8.0.13",
    "lit": "^3.3.3"
  }
}
